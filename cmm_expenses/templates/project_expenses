{% extends "base.html" %}

{% block title %}{{ project.name }} Expenses — CMM Chronos{% endblock %}
{% block page_title %}{{ project.name }}{% endblock %}

{% block topbar_actions %}
  <a href="{% url 'cmm_project_list' %}" class="btn btn-secondary">
    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" style="width:14px;height:14px;"><path d="M19 12H5M12 5l-7 7 7 7"/></svg>
    Projects
  </a>
  <a href="{% url 'cmm_add_expense' project.pk %}" class="btn btn-primary">
    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" style="width:14px;height:14px;"><line x1="12" y1="5" x2="12" y2="19"/><line x1="5" y1="12" x2="19" y2="12"/></svg>
    Add Expense
  </a>
{% endblock %}

{% block content %}

<!-- Project Summary Strip -->
<div class="stats-grid" style="margin-bottom:20px;">
  <div class="stat-card accent">
    <div class="stat-label">Contract Value</div>
    <div class="stat-value">K {{ project.contract_value|floatformat:2 }}</div>
  </div>
  <div class="stat-card success">
    <div class="stat-label">Received</div>
    <div class="stat-value">K {{ project.paid_value|floatformat:2 }}</div>
  </div>
  <div class="stat-card warning">
    <div class="stat-label">Total Expenses</div>
    <div class="stat-value">K {{ project.expense_value|floatformat:2 }}</div>
  </div>
  <div class="stat-card">
    <div class="stat-label">Pending Payment</div>
    <div class="stat-value">K {{ project.pending_payment_value|floatformat:2 }}</div>
  </div>
  <div class="stat-card {% if project.profit_value >= 0 %}success{% else %}accent{% endif %}">
    <div class="stat-label">Net Profit</div>
    <div class="stat-value">K {{ project.profit_value|floatformat:2 }}</div>
  </div>
</div>

<!-- Expenses Table -->
<div class="table-card">
  <div class="table-header">
    <span class="table-title">Project <span class="table-title-accent">Expenses</span></span>
    <span style="font-size:12px; color:var(--gray-600);">{{ expenses|length }} record{{ expenses|length|pluralize }}</span>
  </div>

  {% if expenses %}
  <table>
    <thead>
      <tr>
        <th>Description</th>
        <th>Category</th>
        <th>Date</th>
        <th style="text-align:right;">Amount (K)</th>
        <th></th>
      </tr>
    </thead>
    <tbody>
      {% for expense in expenses %}
      <tr>
        <td style="font-weight:500;">{{ expense.description }}</td>
        <td>
          {% if expense.tag %}
            <span class="badge badge-gray">{{ expense.tag }}</span>
          {% else %}
            <span style="color:var(--gray-400);">—</span>
          {% endif %}
        </td>
        <td style="color:var(--gray-600); font-size:13px;">{{ expense.date|date:"d M Y" }}</td>
        <td style="text-align:right;" class="currency currency-negative">{{ expense.amount|floatformat:2 }}</td>
        <td>
          <div class="td-actions" style="justify-content:flex-end;">
            <a href="{% url 'cmm_edit_expense' expense.pk %}" class="action-btn action-btn-edit">
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M11 4H4a2 2 0 0 0-2 2v14a2 2 0 0 0 2 2h14a2 2 0 0 0 2-2v-7"/><path d="M18.5 2.5a2.121 2.121 0 0 1 3 3L12 15l-4 1 1-4 9.5-9.5z"/></svg>
              Edit
            </a>
            <a href="{% url 'cmm_delete_expense' expense.pk %}" class="action-btn action-btn-delete">
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><polyline points="3 6 5 6 21 6"/><path d="M19 6l-1 14H6L5 6"/><path d="M10 11v6M14 11v6"/><path d="M9 6V4h6v2"/></svg>
              Delete
            </a>
          </div>
        </td>
      </tr>
      {% endfor %}
    </tbody>
    <tfoot>
      <tr style="background:var(--gray-100);">
        <td colspan="3" style="padding:12px 16px; font-size:11px; font-weight:700; letter-spacing:0.8px; text-transform:uppercase; color:var(--gray-600);">Total Expenses</td>
        <td style="text-align:right; padding:12px 16px; font-size:15px; font-weight:700; color:var(--red);">K {{ project.expense_value|floatformat:2 }}</td>
        <td></td>
      </tr>
    </tfoot>
  </table>
  {% else %}
  <div class="empty-state">
    <div class="empty-title">No expenses yet</div>
    <div class="empty-text">Record expenses for this project to track profitability.</div>
    <a href="{% url 'cmm_add_expense' project.pk %}" class="btn btn-primary">Add First Expense</a>
  </div>
  {% endif %}
</div>

{% endblock %}
